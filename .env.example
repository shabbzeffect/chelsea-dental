# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/chelsea_dental"

# Authentication
SESSION_SECRET="your-super-secret-session-key-change-in-production"
JWT_SECRET="your-jwt-secret-change-in-production"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Chelsea Dental Clinic"

# Email - SendGrid (Production)
# Get your API key from https://app.sendgrid.com/settings/api_keys
# Verify your sender email at https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY=""
FROM_EMAIL="noreply@chelseadental.com"

# Email - SMTP Fallback (Development/Testing)
# Used when SENDGRID_API_KEY is not set
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
